graph TD
    %% 初始化阶段
    subgraph Init [1. 环境初始化]
    A["配置地图参数<br/>(MazeMapConfig)"] --> B["生成随机迷宫<br/>(Generator)"]
    B --> C["墙体几何提取<br/>(Wall Conversion)"]
    C --> D["初始化机器人<br/>(N7carRobot)"]
    D --> E["部署动态障碍物<br/>(DynamicObstacles)"]
    end

    %% 仿真循环阶段
    subgraph Sim [2. 实时仿真循环]
    E --> F{启动循环}
    F --> G["<b>物理计算层</b>"]
    G --> G1["障碍物更新<br/>及墙体反弹"]
    G --> G2["N7car 状态更新<br/>与目标检测"]
    G1 & G2 --> H["<b>渲染引擎</b><br/>(SceneRenderer)"]
    H --> I["屏幕刷新<br/>(30 FPS)"]
    I --> J{检测退出?}
    J -- 否 --> G
    J -- 是 --> K[清理资源并退出]
    end

    %% 颜色美化
    style Init fill:#f0f7ff,stroke:#005cc5,stroke-width:2px
    style Sim fill:#fff9f0,stroke:#d4a017,stroke-width:2px
    style G fill:#f6ffed,stroke:#52c41a
    style H fill:#fff0f6,stroke:#eb2f96